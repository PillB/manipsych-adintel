{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ManipulationTechnique",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "psychological_mechanism",
    "examples",
    "triggers",
    "language_patterns",
    "citations"
  ],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "category": {"type": "string"},
    "psychological_mechanism": {"type": "string"},
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["domain", "description"],
        "properties": {
          "domain": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "triggers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "language_patterns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "citations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
